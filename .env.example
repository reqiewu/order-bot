# 1. Telegram-бот (алерты в личку + Mini App)
TELEGRAM_BOT_TOKEN=
OPERATOR_TELEGRAM_ID=

# 2. Шифрование токенов в базе (любая строка)
TOKEN_ENCRYPTION_KEY=change-me-local

# 3. Telegram user-сессия (маркеты + Gift Marketplace)
# Ключи: https://my.telegram.org/apps
# Логин: go run ./cmd/tg-login  →  data/tg.session
# Если сессия умерла — обнови через tg-login, токены маркетов из env не читаются.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=data/tg.session
# TELEGRAM_PHONE=+7999…
# TELEGRAM_2FA_PASSWORD=

# 4. Runtime
BOLT_PATH=data/order-bot.db
ASSETS_DIR=data/assets
POLL_INTERVAL_SEC=1
LOG_LEVEL=info
METRICS_ADDR=:9091

# 5. Mini App (Docker: make start)
MINIAPP_PORT=8080
MINIAPP_STATIC_DIR=web/dist
# HTTPS туннеля — кнопка Mini App в /start
# MINIAPP_PUBLIC_URL=https://xxxx.ngrok-free.app

# 6. Grafana (только 127.0.0.1:3000, не в туннель Mini App)
# ssh -L 3000:127.0.0.1:3000 vps  →  http://localhost:3000  admin / этот пароль
# Дашборды: order-bot (метрики) и order-bot logs. Loki с хоста не слушает.
GRAFANA_ADMIN_PASSWORD=changeme

# Опционально: слоты при старте (лучше добавить в Mini App)
# WATCH_SLOTS_JSON=[{"collection":"Lunar Snake","model":"Albino"}]
WATCH_SLOTS_JSON=
