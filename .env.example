# 1. Telegram-бот (алерты в личку + Mini App)
TELEGRAM_BOT_TOKEN=
OPERATOR_TELEGRAM_ID=

# 2. Шифрование токенов в базе (любая строка)
TOKEN_ENCRYPTION_KEY=change-me-local

# 3. Маркеты — пусто = рынок выключен (не поллим, не логируем листинг)
MRKT_TOKEN=
PORTALS_TOKEN=
GETGEMS_TOKEN=
TONNEL_TOKEN=

# 4. Telegram Gift Marketplace (user-сессия, не bot token)
# Ключи: https://my.telegram.org/apps
# Логин: go run ./cmd/tg-login  →  data/tg.session
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=data/tg.session
# TELEGRAM_PHONE=+7999…
# TELEGRAM_2FA_PASSWORD=

# 5. Runtime
BOLT_PATH=data/order-bot.db
POLL_INTERVAL_SEC=1
LOG_LEVEL=info

# 6. Mini App (Docker: make start)
MINIAPP_PORT=8080
MINIAPP_STATIC_DIR=web/dist
# HTTPS туннеля — кнопка Mini App в /start
# MINIAPP_PUBLIC_URL=https://xxxx.ngrok-free.app

# Опционально: слоты при старте (лучше добавить в Mini App)
# WATCH_SLOTS_JSON=[{"collection":"Lunar Snake","model":"Albino"}]
WATCH_SLOTS_JSON=
