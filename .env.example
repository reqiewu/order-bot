# Telegram
TELEGRAM_BOT_TOKEN=
OPERATOR_TELEGRAM_ID=

# AES key for tokens in Bbolt (any string → SHA-256, or 32-byte base64)
TOKEN_ENCRYPTION_KEY=change-me-local

# Markets (bootstrap; Mini App overrides and persists encrypted)
MRKT_TOKEN=
PORTALS_TMA=
# Getgems Read API (buy + quote). Ключ: https://api.getgems.io/public-api/docs
GETGEMS_API_KEY=

# Runtime
BOLT_PATH=data/order-bot.db
POLL_INTERVAL_SEC=90
# Логи: debug|info|warn|error
# info — list ok + slot/listing diff (до 30 шт.; больше → summary, детали в debug)
LOG_LEVEL=info
# LOG_DEBUG=1  # alias для LOG_LEVEL=debug

# Mini App HTTP (Docker: make start; tunnel → MINIAPP_PORT)
MINIAPP_ADDR=:8080
MINIAPP_STATIC_DIR=web/dist
MINIAPP_PORT=8080
# HTTPS URL туннеля — кнопка Mini App в /start и /app
# MINIAPP_PUBLIC_URL=https://xxxx.ngrok-free.app
# MINIAPP_DISABLED=1
# Local API without Telegram signature:
# MINIAPP_DEV=1
# MINIAPP_DEV_USER_ID=123456789

# Optional bootstrap watch slots (JSON). Prefer Mini App after first run.
# WATCH_SLOTS_JSON=[{"collection":"Lunar Snake","model":"Albino"}]
WATCH_SLOTS_JSON=

# Справочный TON/USDT в paper-алерте: CoinMarketCap Gram (id 11419), кэш ~45s.
# На спред/триггер не влияет.
