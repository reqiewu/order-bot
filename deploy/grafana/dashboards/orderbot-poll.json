{
  "uid": "orderbot-poll",
  "title": "order-bot",
  "tags": ["order-bot"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"]
  },
  "annotations": { "list": [] },
  "links": [
    {
      "title": "Logs",
      "type": "link",
      "icon": "doc",
      "url": "/d/orderbot-logs/order-bot-logs",
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "market",
        "label": "Market",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(orderbot_listings, market)",
        "query": { "query": "label_values(orderbot_listings, market)", "refId": "A" },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": { "selected": true, "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Overview",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Telegram session",
      "description": "User session used for market auth",
      "gridPos": { "x": 0, "y": 1, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "down", "color": "red" },
                "1": { "text": "ok", "color": "green" }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        { "refId": "A", "expr": "orderbot_tg_session", "legendFormat": "session" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Listings",
      "description": "Sum across markets, last successful poll tick",
      "gridPos": { "x": 6, "y": 1, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "text", "value": null },
              { "color": "green", "value": 0 }
            ]
          },
          "custom": { "axisSoftMin": 0 }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        { "refId": "A", "expr": "sum(orderbot_listings{market=~\"$market\"})", "legendFormat": "listings" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Poll errors",
      "description": "List failures per second",
      "gridPos": { "x": 12, "y": 1, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 2,
          "noValue": "0",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 0.1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        { "refId": "A", "expr": "sum(rate(orderbot_poll_errors_total{market=~\"$market\"}[1m])) or vector(0)", "legendFormat": "errors" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Paper alerts",
      "description": "Delivered signals in the selected range",
      "gridPos": { "x": 18, "y": 1, "w": 6, "h": 5 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null },
              { "color": "purple", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "textMode": "value_and_name",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        { "refId": "A", "expr": "sum(increase(orderbot_paper_alerts_total{market=~\"$market\"}[$__range])) or vector(0)", "legendFormat": "alerts" }
      ]
    },
    {
      "id": 300,
      "type": "row",
      "title": "Markets",
      "collapsed": false,
      "gridPos": { "x": 0, "y": 6, "w": 24, "h": 1 }
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Poll latency p95",
      "gridPos": { "x": 0, "y": 7, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0,
            "stacking": { "group": "A", "mode": "none" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": ["mean", "max", "lastNotNull"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (market, le) (rate(orderbot_poll_seconds_bucket{market=~\"$market\"}[1m])))",
          "legendFormat": "{{market}}"
        }
      ]
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "Poll errors",
      "gridPos": { "x": 12, "y": 7, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "palette-classic" },
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 20,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0,
            "stacking": { "group": "A", "mode": "none" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": ["mean", "max", "lastNotNull"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (market) (rate(orderbot_poll_errors_total{market=~\"$market\"}[1m]))",
          "legendFormat": "{{market}}"
        }
      ]
    },
    {
      "id": 33,
      "type": "timeseries",
      "title": "Listings in last tick",
      "gridPos": { "x": 0, "y": 15, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "min": 0,
          "decimals": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 12,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0,
            "stacking": { "group": "A", "mode": "none" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": ["mean", "lastNotNull"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        { "refId": "A", "expr": "orderbot_listings{market=~\"$market\"}", "legendFormat": "{{market}}" }
      ]
    },
    {
      "id": 34,
      "type": "timeseries",
      "title": "Paper alerts",
      "gridPos": { "x": 12, "y": 15, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "palette-classic" },
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 16,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0,
            "stacking": { "group": "A", "mode": "none" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": ["mean", "max", "lastNotNull"],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (market) (rate(orderbot_paper_alerts_total{market=~\"$market\"}[5m]))",
          "legendFormat": "{{market}}"
        },
        {
          "refId": "B",
          "expr": "sum by (market) (rate(orderbot_paper_alert_errors_total{market=~\"$market\"}[5m]))",
          "legendFormat": "{{market}} fail"
        }
      ]
    },
    {
      "id": 400,
      "type": "row",
      "title": "Runtime",
      "collapsed": true,
      "gridPos": { "x": 0, "y": 23, "w": 24, "h": 1 },
      "panels": [
        {
          "id": 41,
          "type": "timeseries",
          "title": "RSS memory",
          "gridPos": { "x": 0, "y": 24, "w": 8, "h": 7 },
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "fieldConfig": {
            "defaults": {
              "unit": "bytes",
              "color": { "mode": "fixed", "fixedColor": "semi-dark-blue" },
              "min": 0,
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "smooth",
                "lineWidth": 2,
                "fillOpacity": 18,
                "gradientMode": "hue",
                "showPoints": "never",
                "spanNulls": true,
                "axisSoftMin": 0,
                "stacking": { "group": "A", "mode": "none" }
              }
            },
            "overrides": []
          },
          "options": {
            "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false, "calcs": ["lastNotNull"] },
            "tooltip": { "mode": "single", "sort": "none" }
          },
          "targets": [
            { "refId": "A", "expr": "process_resident_memory_bytes", "legendFormat": "rss" }
          ]
        },
        {
          "id": 42,
          "type": "timeseries",
          "title": "Goroutines",
          "gridPos": { "x": 8, "y": 24, "w": 8, "h": 7 },
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "decimals": 0,
              "color": { "mode": "fixed", "fixedColor": "semi-dark-orange" },
              "min": 0,
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "smooth",
                "lineWidth": 2,
                "fillOpacity": 18,
                "gradientMode": "hue",
                "showPoints": "never",
                "spanNulls": true,
                "axisSoftMin": 0,
                "stacking": { "group": "A", "mode": "none" }
              }
            },
            "overrides": []
          },
          "options": {
            "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false, "calcs": ["lastNotNull"] },
            "tooltip": { "mode": "single", "sort": "none" }
          },
          "targets": [
            { "refId": "A", "expr": "go_goroutines", "legendFormat": "goroutines" }
          ]
        },
        {
          "id": 43,
          "type": "timeseries",
          "title": "CPU",
          "gridPos": { "x": 16, "y": 24, "w": 8, "h": 7 },
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "fieldConfig": {
            "defaults": {
              "unit": "none",
              "decimals": 2,
              "color": { "mode": "fixed", "fixedColor": "semi-dark-green" },
              "min": 0,
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "smooth",
                "lineWidth": 2,
                "fillOpacity": 18,
                "gradientMode": "hue",
                "showPoints": "never",
                "spanNulls": true,
                "axisSoftMin": 0,
                "stacking": { "group": "A", "mode": "none" }
              }
            },
            "overrides": []
          },
          "options": {
            "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false, "calcs": ["lastNotNull"] },
            "tooltip": { "mode": "single", "sort": "none" }
          },
          "targets": [
            { "refId": "A", "expr": "rate(process_cpu_seconds_total[1m])", "legendFormat": "cores" }
          ]
        },
        {
          "id": 44,
          "type": "timeseries",
          "title": "Heap in use",
          "gridPos": { "x": 0, "y": 31, "w": 8, "h": 7 },
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "fieldConfig": {
            "defaults": {
              "unit": "bytes",
              "color": { "mode": "fixed", "fixedColor": "semi-dark-purple" },
              "min": 0,
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "smooth",
                "lineWidth": 2,
                "fillOpacity": 18,
                "gradientMode": "hue",
                "showPoints": "never",
                "spanNulls": true,
                "axisSoftMin": 0,
                "stacking": { "group": "A", "mode": "none" }
              }
            },
            "overrides": []
          },
          "options": {
            "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false, "calcs": ["lastNotNull"] },
            "tooltip": { "mode": "single", "sort": "none" }
          },
          "targets": [
            { "refId": "A", "expr": "go_memstats_heap_inuse_bytes", "legendFormat": "heap" }
          ]
        },
        {
          "id": 45,
          "type": "timeseries",
          "title": "GC pause p75",
          "gridPos": { "x": 8, "y": 31, "w": 8, "h": 7 },
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "fieldConfig": {
            "defaults": {
              "unit": "s",
              "color": { "mode": "fixed", "fixedColor": "semi-dark-yellow" },
              "min": 0,
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "smooth",
                "lineWidth": 2,
                "fillOpacity": 18,
                "gradientMode": "hue",
                "showPoints": "never",
                "spanNulls": true,
                "axisSoftMin": 0,
                "stacking": { "group": "A", "mode": "none" }
              }
            },
            "overrides": []
          },
          "options": {
            "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false, "calcs": ["lastNotNull"] },
            "tooltip": { "mode": "single", "sort": "none" }
          },
          "targets": [
            { "refId": "A", "expr": "go_gc_duration_seconds{quantile=\"0.75\"}", "legendFormat": "p75" }
          ]
        },
        {
          "id": 46,
          "type": "timeseries",
          "title": "Open FDs",
          "gridPos": { "x": 16, "y": 31, "w": 8, "h": 7 },
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "decimals": 0,
              "color": { "mode": "fixed", "fixedColor": "semi-dark-red" },
              "min": 0,
              "custom": {
                "drawStyle": "line",
                "lineInterpolation": "smooth",
                "lineWidth": 2,
                "fillOpacity": 18,
                "gradientMode": "hue",
                "showPoints": "never",
                "spanNulls": true,
                "axisSoftMin": 0,
                "stacking": { "group": "A", "mode": "none" }
              }
            },
            "overrides": []
          },
          "options": {
            "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false, "calcs": ["lastNotNull"] },
            "tooltip": { "mode": "single", "sort": "none" }
          },
          "targets": [
            { "refId": "A", "expr": "process_open_fds", "legendFormat": "fds" }
          ]
        }
      ]
    }
  ]
}
