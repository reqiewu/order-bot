{
  "uid": "orderbot-logs",
  "title": "order-bot logs",
  "tags": ["order-bot"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m"]
  },
  "annotations": { "list": [] },
  "links": [
    {
      "title": "Metrics",
      "type": "link",
      "icon": "dashboard",
      "url": "/d/orderbot-poll/order-bot",
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "level",
        "label": "Log level",
        "type": "custom",
        "hide": 0,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "query": "DEBUG,INFO,WARN,ERROR",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "options": [
          { "text": "All", "value": "$__all", "selected": true },
          { "text": "DEBUG", "value": "DEBUG", "selected": false },
          { "text": "INFO", "value": "INFO", "selected": false },
          { "text": "WARN", "value": "WARN", "selected": false },
          { "text": "ERROR", "value": "ERROR", "selected": false }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Log rate",
      "description": "Filtered by Log level (All = every line, including list ok)",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 18,
            "gradientMode": "hue",
            "showPoints": "never",
            "spanNulls": true,
            "axisSoftMin": 0,
            "stacking": { "group": "A", "mode": "none" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false, "calcs": [] },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({job=\"order-bot\"} | detected_level =~ \"(?i)($level)\" [1m]))",
          "legendFormat": "lines"
        }
      ]
    },
    {
      "id": 2,
      "type": "logs",
      "title": "Logs",
      "description": "Zap console after decolorize. All = every line. Pick WARN / ERROR to hide list ok.",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 20 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": false,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "expr": "{job=\"order-bot\"} | detected_level =~ \"(?i)($level)\"",
          "queryType": "range",
          "maxLines": 500
        }
      ]
    }
  ]
}
